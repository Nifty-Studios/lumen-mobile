{
  "expo": {
    "name": "Lumen",
    "slug": "lumen",
    "scheme": "lumen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0b0c1a",
    "android": {
      "package": "studio.nifty.lumen",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0b0c1a"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "./plugins/with-cmake-version",
      "expo-sharing",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lumen uses your location to show the real sky and weather where you are.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-audio",
      "expo-video",
      "./plugins/with-release-signing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
