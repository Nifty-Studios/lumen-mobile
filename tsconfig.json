{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // @lumen/shared is linked and has its own dev copies; type-check against ours.
    "paths": {
      "drizzle-orm": ["./node_modules/drizzle-orm"],
      "drizzle-orm/*": ["./node_modules/drizzle-orm/*"],
      "@blocknote/core": ["./node_modules/@blocknote/core"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
